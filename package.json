{
  "name": "owasaka",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "react:dev": "pnpm --filter @owasaka/react-frontend dev",
    "react:build": "pnpm --filter @owasaka/react-frontend build",
    "react:typecheck": "pnpm --filter @owasaka/react-frontend typecheck",
    "svelte:dev": "pnpm --filter web dev",
    "svelte:build": "pnpm --filter web build",
    "svelte:check": "pnpm --filter web check",
    "frontend:build": "pnpm react:typecheck && pnpm react:build && pnpm svelte:check && pnpm svelte:build"
  }
}
