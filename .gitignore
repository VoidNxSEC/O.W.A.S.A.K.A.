*.exe~
*.dll
*.so
*.dylib
# oswaka (removed to allow cmd/oswaka directory)
cmd/oswaka/oswaka
.cache
# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Dependency directories
vendor/
node_modules/

# Go workspace file
go.work
go.work.sum

# Environment variables
.env
.env.local
.env.*.local

# Secrets (see ADR-0059 and ../owasaka-docs/docs/secrets/BOOTSTRAP.md)
# - secrets.yaml is the encrypted file, committed as-is (sops-encrypted)
# - secrets.dec.yaml is the decrypted form, NEVER commit
# - .sops/age/ holds private keys, NEVER commit
secrets.dec.yaml
secrets.dec.*.yaml
.sops/age/
*.age.key

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

