#!/usr/bin/env bash
# owasaka-seal — rofi prompt to seal an arbitrary host IP.
# Super+Alt+X in Hyprland.
# Does NOT require an existing alert — can seal any IP.

set -euo pipefail

HOST="${OSWAKA_HOST:-localhost:8080}"
TOKEN="${OSWAKA_TOKEN:-}"
API="http://${HOST}"

auth_header() {
    [[ -n "$TOKEN" ]] && echo "Authorization: Bearer $TOKEN" || echo "X-No-Auth: 1"
}

# ── Step 1: enter IP ──────────────────────────────────────────────────────────

ip=$(rofi \
    -dmenu \
    -p "Seal Host — enter IP" \
    -mesg "Super+Alt+X  •  Enter IP address to block" \
    -theme-str '
        window   { width: 500px; border: 2px solid #ff3333; border-radius: 10px; }
        mainbox  { padding: 12px; background-color: #0d1820; }
        inputbar { background-color: #0d1820; border: 1px solid #ff3333; border-radius: 6px; padding: 8px 12px; }
        entry    { text-color: #ff5555; font: "JetBrainsMono Nerd Font Bold 13"; }
        prompt   { text-color: #ff3333; font: "JetBrainsMono Nerd Font Bold 13"; }
        listview { lines: 0; }
        message  { padding: 6px; }
        textbox  { text-color: #4a5a62; font: "JetBrainsMono Nerd Font 11"; }
    ' \
    < /dev/null) || exit 0

ip="${ip// /}"
if [[ -z "$ip" ]]; then
    exit 0
fi

# ── Step 2: confirm ───────────────────────────────────────────────────────────

nft_cmd="nft add rule inet filter input ip saddr ${ip} drop"

confirm=$(printf "SEAL — block %s now\nCANCEL" "$ip" | \
    rofi \
    -dmenu \
    -p "Confirm seal: $ip" \
    -mesg "$nft_cmd" \
    -theme-str '
        window   { width: 600px; border: 2px solid #ff3333; border-radius: 10px; }
        mainbox  { padding: 8px; background-color: #0d1820; }
        inputbar { background-color: #0d1820; border: 1px solid #1e2e3a; border-radius: 6px; padding: 6px 10px; }
        entry    { text-color: #a6b4bb; }
        prompt   { text-color: #ff3333; font: "JetBrainsMono Nerd Font Bold 12"; }
        listview { lines: 2; background-color: transparent; }
        element  { padding: 6px 10px; border-radius: 6px; }
        element selected.normal { background-color: rgba(255,51,51,0.18); text-color: #ff5555; }
        element-text { text-color: #a6b4bb; font: "JetBrainsMono Nerd Font 12"; }
        message  { padding: 8px; }
        textbox  { text-color: #f2b84b; font: "JetBrainsMono Nerd Font 11"; }
    ' \
) || exit 0

[[ "$confirm" == CANCEL* ]] && exit 0

# ── Step 3: send to API + copy nftables to clipboard ─────────────────────────

echo -n "$nft_cmd" | wl-copy 2>/dev/null || true

api_ok=false
if curl -sf -X POST \
    -H "$(auth_header)" \
    -H "Content-Type: application/json" \
    -d "{\"ip\":\"${ip}\"}" \
    "${API}/api/incidents/containment" > /dev/null 2>&1; then
    api_ok=true
fi

if [[ "$api_ok" == true ]]; then
    notify-send --urgency=critical --app-name=OWASAKA \
        "Sealed — ${ip}" \
        "Containment recorded in SIEM.\nnftables rule copied to clipboard."
else
    notify-send --urgency=critical --app-name=OWASAKA \
        "Sealed — ${ip}" \
        "API offline — run as root:\n${nft_cmd}\n\n(Copied to clipboard)"
fi
