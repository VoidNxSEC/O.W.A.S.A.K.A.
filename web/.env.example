# OWASAKA SvelteKit Frontend — environment variables
#
# Copy to .env.local (never commit .env.local)

# Override the backend host:port that the frontend connects to.
# Defaults to window.location.host (same origin).
# Useful when running the frontend dev server on a different port
# than the Go backend (e.g. pnpm dev on :5173, Go on :8080).
#
# VITE_API_HOST=localhost:8080
