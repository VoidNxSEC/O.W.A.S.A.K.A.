{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": [
    "src/routes",
    "src/app.d.ts",
    "src/lib/websocket.ts",
    "src/lib/EventDetail.svelte",
    "src/lib/ThreatBanner.svelte",
    "src/lib/TopologyGraph.svelte"
  ]
}
